  "cards": [
    { "dot": "emerald", "title": "Request path", "items": [
      "Browser calls same-origin /api; Vercel rewrites it to the Render service",
      "Every /api route except health and client-errors needs a Bearer token",
      "The API builds a Supabase client from the caller's token for each request"
    ] },
    { "dot": "rose", "title": "Security", "items": [
      "Row-level security isolates users; the server holds only the anon key",
      "IP limits run before body parsing; body cap 100 kB, 6 MB for photo parsing",
      "GEMINI_API_KEY lives only in the Render environment"
    ] },
    { "dot": "amber", "title": "Reliability", "items": [
      "/api/health checks required columns and answers 503 when the schema is behind",
      "Render deploys only after CI checks pass",
      "Gemini calls have a 25 s deadline and one retry on 429/503"
    ] },
    { "dot": "slate", "title": "Not drawn", "items": [
      "API also signs photo URLs and removes files in Storage",
      "Exercise photos load from jsDelivr and are cached by the service worker",
      "A usage row is written to ai_usage before each Gemini call"
    ] }
  ]
