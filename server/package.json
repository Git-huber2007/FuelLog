{
  "name": "@fuellog/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/index.js",
    "start": "node dist/index.js",
    "test": "tsx --test src/__tests__/*.test.ts"
  },
  "dependencies": {
    "@fuellog/shared": "*",
    "@google/genai": "^1.20.0",
    "@supabase/supabase-js": "^2.45.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.0",
    "cors": "^2.8.5",
    "esbuild": "^0.25.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
